{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Leo Software Design System — Warm Operator. Dark charcoal surfaces with amber accents. Built for restaurant, shop, and warehouse POS operators.",
  "color": {
    "$type": "color",
    "light": {
      "background":               { "$value": "#FFFBEB" },
      "foreground":               { "$value": "#1C1917" },
