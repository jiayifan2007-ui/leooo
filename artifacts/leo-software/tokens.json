      "accent":                   { "$value": "#44403C" },
      "accentForeground":         { "$value": "#FCD34D" },
      "destructive":              { "$value": "#EF4444" },
      "destructiveForeground":    { "$value": "#FFFFFF" },
      "input":                    { "$value": "#44403C" },
      "ring":                     { "$value": "#F59E0B" },
      "chart1":                   { "$value": "#FCD34D" },
      "chart2":                   { "$value": "#34D399" },
      "chart3":                   { "$value": "#60A5FA" },
      "chart4":                   { "$value": "#A78BFA" },
      "chart5":                   { "$value": "#F87171" },
      "sidebar":                  { "$value": "#0C0A09" },
      "sidebarForeground":        { "$value": "#F5F5F4" },
      "sidebarBorder":            { "$value": "#292524" },
      "sidebarPrimary":           { "$value": "#F59E0B" },
      "sidebarPrimaryForeground": { "$value": "#1C1917" },
      "sidebarAccent":            { "$value": "#292524" },
      "sidebarAccentForeground":  { "$value": "#FCD34D" },
      "sidebarRing":              { "$value": "#F59E0B" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Inter", "sans-serif"],    "$description": "UI and body face." },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono":  { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.375rem", "$description": "Slightly compact — professional tool, not a consumer app." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
